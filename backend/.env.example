# Set real Razorpay test/live credentials in your environment, never commit them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# INR amount in paise: 19900 = ₹199.00. Change this to your chosen gift price.
GIFT_PRICE_PAISE=19900
GIFT_CURRENCY=INR

# Public origin of the deployed Next.js frontend.
FRONTEND_ORIGIN=http://localhost:3000
